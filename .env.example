# Copia este archivo a .env.local y añade tu clave real.

# --- OpenCode Go (recomendado) ---------------------------------------------
# Suscripción de OpenCode con acceso a DeepSeek Flash entre otros modelos.
# Clave: https://opencode.ai/auth  (sección OpenCode Go)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# --- Alternativa: DeepSeek directo -----------------------------------------
# Solo se usa si OPENCODE_API_KEY está vacío.
# Clave: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
